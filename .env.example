# ---------------------------------------------------------------------------
# loomy2api configuration
# Copy to .env and edit.  `chmod 600 .env` is recommended.
# ---------------------------------------------------------------------------

# --- required --------------------------------------------------------------
# The key YOUR clients must present as `Authorization: Bearer <key>`.
# Generate one, e.g.:  openssl rand -hex 24
LOOMY_API_KEY=change-this-local-key

# Used to build the noVNC link on the login page. Hostname or IP that reaches
# this container from your browser.
PUBLIC_HOST=192.168.1.100

# --- server ----------------------------------------------------------------
PORT=7865
LOG_LEVEL=INFO

# --- paths (inside the container) ------------------------------------------
DATABASE_PATH=/app/data/loomy2api.db
SESSION_STATE_PATH=/app/data/loomy-storage-state.json

# --- upstream --------------------------------------------------------------
LOOMY_WEB_URL=https://loomy.xunfei.cn/web
LOOMY_API=https://loomy.xunfei.cn/web/api/chat/completions
# Optional: set only if you need a non-default upstream origin/referer base.
# LOOMY_BASE_URL=https://loomy.xunfei.cn

# --- admin -----------------------------------------------------------------
# Required to authorise write operations on /admin/api/* (add / delete /
# enable / set cookie / refresh).
# If left empty, writes fall back to LOOMY_API_KEY.  If BOTH are empty, all
# admin writes are refused with HTTP 403 rather than left open.
# ADMIN_TOKEN=

# --- account pool (optional; defaults shown) -------------------------------
# CREDIT_REFRESH_INTERVAL=45          # seconds between quota refreshes
# CREDIT_REFRESH_GAP=0.8              # pause between accounts in a refresh sweep
# POOL_MAX_IN_FLIGHT=3                # concurrent requests allowed per account
# POOL_BREAKER_THRESHOLD=3            # consecutive upstream errors before cooldown
# POOL_BREAKER_COOLDOWN=1800          # base cooldown seconds (doubles per strike)
# POOL_BREAKER_COOLDOWN_MAX=21600     # cooldown ceiling
# POOL_SOFT_RATE_COOLDOWN=600         # cooldown after HTTP 429 (doubles per strike)
# POOL_SOFT_RATE_COOLDOWN_MAX=7200
# POOL_QUOTA_FLOOR=0.15               # weight floor so a low-quota account stays in rotation
# POOL_IDLE_WEIGHT_PER_HOUR=0.5       # idle accounts gain weight for fairness
# POOL_IDLE_WEIGHT_MAX=5.0
# POOL_STICKY_ENABLED=true            # pin a session to one account while usable
# POOL_STICKY_TTL=1800
# POOL_STICKY_GC_INTERVAL=300
# POOL_FAILOVER_ENABLED=true
# POOL_FAILOVER_ATTEMPTS=3
# POOL_FAILOVER_DEADLINE=20.0         # total seconds budgeted for one request's failover
# POOL_STATE_SAVE_INTERVAL=30
# DATA_DIR=/app/data                  # anchors accounts.json / accounts/ / pool_state.json
# ACCOUNTS_FILE=/app/data/accounts.json
# ACCOUNTS_DIR=/app/data/accounts
# POOL_STATE_FILE=/app/data/pool_state.json
